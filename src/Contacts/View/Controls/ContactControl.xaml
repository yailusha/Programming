<UserControl x:Class="View.Controls.ContactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls"
             mc:Ignorable="d" Height="151" Width="295">
    <UserControl.Resources>
        <Style x:Key="ErrorToolTipStyle" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                            Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label 
                Grid.Column="2"
                Content="Name:"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"/>
            <Image 
                HorizontalAlignment="Center"
                Height="100"
                Grid.Row="1"
                VerticalAlignment="Top"
                Width="100"
                Source="/photo_placeholder_100x100.png"
                Grid.RowSpan="2"/>
            <Grid Grid.Column="2" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox 
                    TextWrapping="Wrap"
                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    VerticalAlignment="Center"
                    IsReadOnly="{Binding IsReadonly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource ErrorToolTipStyle}"/>
                <Label 
                    Content="Phone Number:"
                    HorizontalAlignment="Left"
                    Grid.Row="2"
                    VerticalAlignment="Center"/>
                <TextBox 
                    x:Name="PhoneNumberTextBox" 
                    Grid.Row="4"
                    TextWrapping="Wrap"
                    Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    VerticalAlignment="Center"
                    IsReadOnly="{Binding IsReadonly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource ErrorToolTipStyle}"/>
                <Label 
                    Content="Email:"
                    HorizontalAlignment="Left"
                    Grid.Row="6"
                    VerticalAlignment="Center"/>
                <TextBox 
                    Grid.Row="8"
                    TextWrapping="Wrap"
                    Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    VerticalAlignment="Center"
                    IsReadOnly="{Binding IsReadonly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource ErrorToolTipStyle}"/>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
