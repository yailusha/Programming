<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts"
        Height="408"
        Width="550"
        MinWidth="550"
        MinHeight="408"
        Icon="/contacts_96x96.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <DataTemplate x:Key="contactTemplate">
            <Grid Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image 
                    Source="/photo_placeholder_100x100.png"
                    Width="50"
                    Height="50"
                    Grid.Column="0"/>
                <StackPanel Grid.Column="1"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock 
                        Text="{Binding Name}"
                        FontSize="12"
                        FontWeight="SemiBold"/>
                    <TextBlock
                        Text="{Binding PhoneNumber}"
                        FontSize="10"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter 
            HorizontalAlignment="Left"
            Width="3"
            Grid.Column="1"
            Background="White"/>
        <Grid Background="#FFF8F8F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3"/>
                <RowDefinition/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="8,8,8,3" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Find:"/>
                <TextBox
                    Grid.Column="2"
                    TextWrapping="Wrap"/>
            </Grid>
            <Grid Grid.Row="3" Margin="8,0,8,0">
                <ListBox
                    ItemTemplate="{StaticResource contactTemplate}"
                    ItemsSource="{Binding Contacts, UpdateSourceTrigger=PropertyChanged}"
                    SelectedItem="{Binding SelectedContact, Mode=TwoWay}"/>
            </Grid>
            <Grid 
                Grid.Row="5"
                Height="25"
                VerticalAlignment="Bottom"
                Margin="8,0,8,8"/>
            <Grid Grid.Row="5" Margin="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button 
                    x:Name="AddButton"
                    Content="Add"
                    Grid.ColumnSpan="3"
                    Command="{Binding AddCommand}"/>
                <Button 
                    x:Name="EditButton"
                    Grid.Column="4"
                    Content="Edit"
                    Command="{Binding EditCommand}"
                    IsEnabled="{Binding IsEnabled}"/>
                <Button 
                    x:Name="RemoveButton"
                    Grid.Column="6"
                    Content="Remove"
                    Command="{Binding RemoveCommand}"
                    IsEnabled="{Binding IsEnabled}"/>
            </Grid>
        </Grid>
        <Grid Grid.Column="1" Margin="8,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>
            <Button 
                        Content="Apply"
                        HorizontalAlignment="Left"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        Width="75"
                        Height="25"
                        Command="{Binding ApplyCommand}"
                        Visibility="{Binding Visible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="99,23,0,0"/>
        </Grid>
    </Grid>
</Window>
