<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="351" Width="496" MinWidth="496" MinHeight="351">
    <Grid>
        <Button Content="Load" Margin="0,0,15,15" Width="75" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        <Button Content="Save" Width="75" Height="25" HorizontalAlignment="Right" Margin="0,0,93,15" VerticalAlignment="Bottom"/>
        <Grid Margin="15,15,15,43">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Edit Contact" Margin="0,0,1.5,0">
                <Grid Margin="3,3,3,3">
                    <Label Content="Name:" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBox Margin="0,29,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    <Label Content="Phone Number:" HorizontalAlignment="Left" Margin="0,50,0,0" VerticalAlignment="Top"/>
                    <TextBox Margin="0,79,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    <Label Content="Email:" HorizontalAlignment="Left" Margin="0,100,0,0" VerticalAlignment="Top"/>
                    <TextBox Margin="0,129,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Read Contact" Margin="1.5,0,0,0">
                <Grid Margin="3,3,3,3">
                    <Label Content="Name:" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Label Content="-" HorizontalAlignment="Left" Margin="0,26,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                    <Label Content="Phone Number:" HorizontalAlignment="Left" Margin="0,50,0,0" VerticalAlignment="Top"/>
                    <Label Content="-" HorizontalAlignment="Left" Margin="0,79,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                    <Label Content="Email:" HorizontalAlignment="Left" Margin="0,100,0,0" VerticalAlignment="Top"/>
                    <Label Content="-" HorizontalAlignment="Left" Margin="0,129,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
