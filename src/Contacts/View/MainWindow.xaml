<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts"
        Height="351"
        Width="496"
        MinWidth="496"
        MinHeight="351"
        Icon="/contacts_96x96.ico">
    <Grid Margin="15,15,15,15">
        <Grid Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GroupBox 
                Header="Edit Contact"                    
                Margin="0,0,1.5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label 
                        Content="Name:"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"/>
                    <TextBox 
                        Grid.Row="2"
                        TextWrapping="Wrap"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        Height="18"/>
                    <Label 
                        Content="Phone Number:"
                        HorizontalAlignment="Left"
                        Grid.Row="4"
                        VerticalAlignment="Top"/>
                    <TextBox 
                        Grid.Row="6"
                        TextWrapping="Wrap"
                        Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                        Height="18"/>
                    <Label 
                        Content="Email:"
                        HorizontalAlignment="Left"
                        Grid.Row="8"
                        VerticalAlignment="Top"/>
                    <TextBox 
                        Grid.Row="10"
                        TextWrapping="Wrap"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Height="18"/>
                </Grid>
            </GroupBox>
            <GroupBox 
                Grid.Column="1"
                Header="Read Contact"
                Margin="1.5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label 
                        Content="Name:"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"/>
                    <TextBlock 
                        Grid.Row="2"
                        TextWrapping="Wrap"
                        Text="{Binding Name}"
                        Height="18"
                        FontWeight="Bold"/>
                    <Label 
                        Content="Phone Number:"
                        HorizontalAlignment="Left"
                        Grid.Row="4"
                        VerticalAlignment="Top"/>
                    <TextBlock 
                        Grid.Row="6"
                        TextWrapping="Wrap"
                        Text="{Binding PhoneNumber}"
                        Height="18"
                        FontWeight="Bold"/>
                    <Label 
                        Content="Email:"
                        HorizontalAlignment="Left"
                        Grid.Row="8"
                        VerticalAlignment="Top"/>
                    <TextBlock 
                        Grid.Row="10"
                        TextWrapping="Wrap"
                        Text="{Binding Email}"
                        Height="18"
                        FontWeight="Bold"/>
                </Grid>
            </GroupBox>
        </Grid>
        <Grid 
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Width="153">
            <Button 
                x:Name="LoadButton"
                Content="Load"
                Width="75" 
                Height="25"
                HorizontalAlignment="Right"
            Command="{Binding LoadCommand}"/>
            <Button 
                x:Name="SaveButton"
                Content="Save"
                Width="75"
                Height="25"
                HorizontalAlignment="Left"
                Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</Window>
